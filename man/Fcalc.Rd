\name{Fcalc}\alias{Fcalc}\title{First-stage diagnostic statistics}
\usage{Fcalc(pix, Vhomy, Vhomx, Vhetx, kz)}
\arguments{\item{pix}{Selected first-stage coefficients.}\item{Vhomy}{Conventional reduced-form covariance matrix.}\item{Vhomx}{Conventional first-stage covariance matrix.}\item{Vhetx}{Alternative first-stage covariance matrix.}\item{kz}{Number of instruments.}}
\description{Compute conventional and robust first-stage diagnostics for a single endogenous variable.}\value{A data frame of diagnostic statistics.}
